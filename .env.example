# Settings for the form functions in /api. Set these in Vercel:
#   Project -> Settings -> Environment Variables
# Never commit real values. For local testing copy this file to .env and fill it in.

# --- SMTP (the mailbox that sends the emails) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# "starttls" (port 587, default), "ssl" (port 465) or "none" (local testing only)
SMTP_SECURE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Flipick

# --- Who receives the emails (comma-separated lists of addresses) ---
# Contact form on /company
RECIPIENTS_CONTACT=
# Campaign lead forms (one per form_id in api/send-campaign-mail.js)
RECIPIENTS_SHOPIFY_USA_LEAD=
RECIPIENTS_VVP_US_RETAIL_LEAD=
RECIPIENTS_DEALERSHIP_LEAD=

# --- Preview / staging only ---
# Send every email to this one address instead of the recipients above.
# Set this for the "Preview" environment in Vercel, never for "Production".
MAIL_OVERRIDE_TO=
