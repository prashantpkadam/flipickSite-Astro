# Settings for the PHP form endpoints (api/.env on the server).
# The deploy workflows write this file from GitHub secrets. Never commit real values.

# --- SMTP (the mailbox that sends the emails) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Flipick

# --- Who receives the emails (comma-separated lists of addresses) ---
# Contact form on /company
RECIPIENTS_CONTACT=
# Campaign lead forms (one per form_id in api/send-campaign-mail.php)
RECIPIENTS_SHOPIFY_USA_LEAD=
RECIPIENTS_VVP_US_RETAIL_LEAD=
RECIPIENTS_DEALERSHIP_LEAD=

# --- Staging only ---
# Send every email to this one address instead of the recipients above.
MAIL_OVERRIDE_TO=
