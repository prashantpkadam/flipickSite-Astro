---
import Layout from "../layouts/Layout.astro";
import schema from "../data/schema/vvp-us-retail.json";
---

<Layout
  title="Variable Video Production for US Retail | Flipick"
  description="One master film becomes a version for every store, offer, market and language, rendered from the data you already publish. Flipick VVP for US retail."
  keywords="Variable Video Production, VVP, localized retail video, per store video, weekly ad video, retail media video"
  page="vvp-us-retail"
  schema={schema}
>
  <main>
    <!-- ================= HERO ================= -->
    <section class="hero camp-hero">
      <div class="wrap">
        <span class="eyebrow dk">Variable Video Production</span>
        <h1>Your prices change every week. <em>Your video doesn't.</em></h1>
        <p class="lead mt-18">
          One master film becomes a version for every store, offer, market and
          language. Rendered from the data you already publish.
        </p>
        <div class="btns mid mt-18">
          <a
            class="btn btn-primary"
            data-demo-link
            href="https://calendly.com/rahul-uppal-flipick/30min"
            target="_blank"
            rel="noopener noreferrer">Book a demo</a
          >
          <a href="#start" class="btn btn-ghost">Send us your weekly ad</a>
        </div>
        <div class="shopify-vid-wrap rv">
          <div class="vid" data-vid="vvp-retail-hero">
            <img
              class="vid-thumb"
              src="/assets/images/thumbnail/vvp-retail-ad.webp"
              alt="VVP retail video — made on Flipick"
              loading="lazy"
              width="820"
              height="461"
            />
            <span class="badge">RETAIL VIDEO &middot; MADE ON FLIPICK</span>
            <div class="ov lower3">
              <b>One master &middot; Every store, every offer</b><span
                >VARIABLE VIDEO PRODUCTION</span>
            </div>
            <a href="#" class="play" aria-label="Play video"></a>
          </div>
        </div>
        <p class="trustline">
          Founded 2011 &middot; Fifteen years in video technology &middot;
          Trusted by <strong>Pearson</strong>, <strong>IIBF</strong>, <strong
            >Godrej</strong
          >, <strong>Jindal Steel</strong>, <strong>IFC World Bank Group</strong
          > and <strong>IICA</strong>
        </p>
      </div>
    </section>

    <!-- ================= THE PROBLEM ================= -->
    <section class="sec" id="how">
      <div class="wrap">
        <div class="prob">
          <div class="rv">
            <span class="eyebrow">The problem</span>
            <h2>
              The most localized business in America runs the least localized
              creative.
            </h2>
            <p class="lead mt-18">
              A flyer for 400 stores is a template. A video for 400 stores has
              always been 400 productions. So you run one national spot, one
              price, for every market you serve. That is a production
              constraint, not a strategy.
            </p>
          </div>
          <div class="rv figs">
            <div>
              <strong>1 spot</strong><span
                >What production economics currently allows nationally.</span>
            </div>
            <div class="hot">
              <strong>400 versions</strong><span
                >What your store list and weekly ad are asking for.</span>
            </div>
            <div>
              <strong>Same budget</strong><span
                >The cost sits in the master, not the versions after it.</span>
            </div>
          </div>
        </div>
        <div class="three">
          <div class="card rv">
            <div class="num">1</div>
            <h3>One master film</h3>
            <p>
              Storyboard approved before a credit is spent. Presenter, product
              and brand world locked scene to scene. No crew, no shoot day.
            </p>
          </div>
          <div class="card rv">
            <div class="num">2</div>
            <h3>Your existing data</h3>
            <p>
              Store list, weekly ad, price file, offer calendar, POS export or
              loyalty segment. CSV or an API connection to your systems.
            </p>
          </div>
          <div class="card rv">
            <div class="num">3</div>
            <h3>The whole version set</h3>
            <p>
              The overlay carries store, address, price, offer, savings, dates,
              language and voice. About a minute per finished video, so large
              sets complete overnight. 9:16 and 16:9 from one run.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= WHERE IT RUNS ================= -->
    <section class="sec mist" id="use">
      <div class="wrap vvp-retail-feat">
        <div class="rv">
          <span class="eyebrow">Where it runs</span>
          <h2>Built for retail that repeats.</h2>
          <ul class="ticks">
            <li>
              <b>Per store.</b> Your national spot carrying this location's address
              and this week's price.
            </li>
            <li>
              <b>Per banner and region.</b> Different assortment, different pricing
              zone, same film.
            </li>
            <li>
              <b>Per language.</b> Spanish is a data field, not a second production.
            </li>
            <li>
              <b>Per member.</b> Loyalty offers cut to the individual, by link or
              email.
            </li>
            <li>
              <b>Per channel.</b> In store screens, paid and organic social, email,
              SMS, retail media, from one render.
            </li>
          </ul>
          <p class="who">
            <strong>Who runs this:</strong> VP Marketing Operations, Co-op Marketing
            Manager, Franchise and Dealer Marketing Director, Retail Media lead
          </p>
        </div>
        <div class="rv">
          <div class="panel">
            <h4>Beyond the cost saving</h4>
            <p>
              The circular is a cost line today, funded partly by co-op and CPG
              dollars. Per store, per week video is not a cost line. It is
              inventory. A brand will pay to appear in it, targeted down to the
              location and the shopper. If you are building a retail media
              network, you already have the demand side.
            </p>
          </div>
          <div class="panel scope">
            <h4>Where it does not fit</h4>
            <p>
              A single brand film, one audience, no data behind it. That is an
              agency job or an off the shelf generator, and we will say so on
              the call rather than after the invoice.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= COMPARE ================= -->
    <section class="sec" id="compare">
      <div class="wrap">
        <div class="sh rv">
          <span class="eyebrow">Compare</span>
          <h2>Against how localized video gets made today.</h2>
        </div>
        <div class="tscroll rv">
          <table class="cmp">
            <thead>
              <tr>
                <th>Dimension</th>
                <th>Traditional production</th>
                <th>Typical AI video tools</th>
                <th class="win">Flipick VVP</th>
              </tr>
            </thead>
            <tbody>
              <tr
                ><td>Cost of version 400</td><td
                  >Roughly the cost of version 1</td
                ><td>A new generation each time</td><td class="win"
                  >A fraction of version 1, and falling</td
                ></tr
              >
              <tr
                ><td>Localization</td><td>Reshoot or re-edit per market</td><td
                  >A name overlay at most</td
                ><td class="win">Store, price, offer, dates, language, voice</td
                ></tr
              >
              <tr
                ><td>Consistency</td><td>Depends on cast availability</td><td
                  >Drifts between scenes</td
                ><td class="win"
                  >Presenter and product locked across the film</td
                ></tr
              >
              <tr
                ><td>Speed to a full set</td><td>Weeks per market</td><td
                  >One clip at a time</td
                ><td class="win">About a minute per video, overnight batches</td
                ></tr
              >
              <tr
                ><td>Price accuracy</td><td
                  >Baked in, a change means a re-edit</td
                ><td>Baked into the generation</td><td class="win"
                  >On the overlay, correctable without a re-render</td
                ></tr
              >
              <tr
                ><td>Proof</td><td>Play counts</td><td>Basic analytics</td><td
                  class="win"
                  >Per viewer completion, drop off and CTA tracking</td
                ></tr
              >
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT FORM ================= -->
    <section class="sec dark" id="start">
      <div class="wrap close">
        <div class="rv">
          <span class="eyebrow dk">Next step</span>
          <h2>
            Send us one week of your data. We will send back the versions.
          </h2>
          <p class="lead dk mt-18">
            A store list, a weekly ad, or a price file. We build the master and
            the full version set on your brand before you commit to anything.
          </p>
          <div class="answers">
            <div>
              <b>Does this replace our agency?</b> No. Strategy, brand, media and
              the relationship stay with you. Flipick is production infrastructure.
              White label available.
            </div>
            <div>
              <b>How fast is the first set?</b> 7 business days for the master, then
              overnight batches for the version set.
            </div>
            <div><b>How is our customer data handled?</b> US Google Cloud.</div>
          </div>
        </div>
        <div class="rv">
          <div class="form">
            <div id="formBody">
              <h3>Get my version set</h3>
              <div class="two">
                <div class="field">
                  <label for="n1">Name <span class="required">*</span></label
                  ><input id="n1" type="text" placeholder="Jane Doe" /><div
                    class="field-error"
                    id="n1Err"
                  >
                  </div>
                </div>
                <div class="field">
                  <label for="n2"
                    >Work email <span class="required">*</span></label
                  ><input
                    id="n2"
                    type="email"
                    placeholder="jane@company.com"
                  /><div class="field-error" id="n2Err"></div>
                </div>
              </div>
              <div class="two">
                <div class="field">
                  <label for="n3">Company <span class="required">*</span></label
                  ><input id="n3" type="text" placeholder="Company name" /><div
                    class="field-error"
                    id="n3Err"
                  >
                  </div>
                </div>
                <div class="field">
                  <label for="n4">Role <span class="required">*</span></label
                  ><input
                    id="n4"
                    type="text"
                    placeholder="VP Marketing Ops"
                  /><div class="field-error" id="n4Err"></div>
                </div>
              </div>
              <div class="two">
                <div class="field">
                  <label for="n5">You are <span class="required">*</span></label
                  >
                  <select id="n5">
                    <option value="">— select one —</option>
                    <option>Retail chain</option>
                    <option>Franchise or dealer network</option>
                    <option>CPG or brand co-op team</option>
                    <option>Retail media network</option>
                    <option>Agency</option>
                  </select>
                  <div class="field-error" id="n5Err"></div>
                </div>
                <div class="field">
                  <label for="n6"
                    >Number of stores <span class="required">*</span></label
                  ><input
                    id="n6"
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    placeholder="250"
                  /><div class="field-error" id="n6Err"></div>
                </div>
              </div>
              <div class="field">
                <label for="n7"
                  >Link to your weekly ad or store list <span class="required"
                    >*</span
                  ></label
                ><input
                  id="n7"
                  type="text"
                  placeholder="Paste a link, or tell us where to look"
                /><div class="field-error" id="n7Err"></div>
              </div>
              <button class="btn btn-primary send" id="send" disabled
                >Get my version set</button
              >
              <div class="form-server-error" id="formServerErr"></div>
              <p class="ffoot">
                Prefer to talk first? <a
                  class="btn-link"
                  data-demo-link
                  href="https://calendly.com/rahul-uppal-flipick/30min"
                  target="_blank"
                  rel="noopener noreferrer">Book a demo</a>
              </p>
            </div>
            <div class="ok" id="okBody" style="display:none">
              <div class="tick">&#10003;</div>
              <h3>Thanks &#8212; message sent.</h3>
              <p>We&#8217;ve got your note and will be in touch shortly.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline slot="scripts" src="/assets/js/video-player.js"></script>
  <script is:inline slot="scripts">
    (function () {
      var rules = {
        n1: { min: 2, msg: "Please enter your name (min 2 characters)." },
        n2: {
          email: true,
          blockPersonal: true,
          msg: "Please enter a valid work email address.",
          msgPersonal:
            "Please enter your work email address. Personal email addresses such as Gmail or Yahoo are not accepted.",
        },
        n3: {
          min: 2,
          msg: "Please enter your company name (min 2 characters).",
        },
        n4: { min: 2, msg: "Please enter your role (min 2 characters)." },
        n5: { select: true, msg: "Please select an option." },
        n6: { numeric: true, msg: "Please enter numbers only (e.g. 250)." },
        n7: {
          min: 4,
          msg: "Please enter a link to your weekly ad or store list.",
        },
      };

      var touched = {};
      var valid = {
        n1: false,
        n2: false,
        n3: false,
        n4: false,
        n5: false,
        n6: false,
        n7: false,
      };
      var btn = document.getElementById("send");
      var srvErr = document.getElementById("formServerErr");

      function validate(id) {
        var el = document.getElementById(id),
          err = document.getElementById(id + "Err"),
          rule = rules[id];
        if (!el || !err || !rule) return;
        var v = el.value.trim();
        var msg = rule.msg;
        var ok;
        if (rule.email) {
          ok = v.length > 0 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
          if (ok && rule.blockPersonal) {
            var domain = v.split("@").pop().toLowerCase();
            var blocked = (window.FLIPICK && FLIPICK.blockedEmailDomains) || [];
            if (blocked.indexOf(domain) !== -1) {
              ok = false;
              msg = rule.msgPersonal || msg;
            }
          }
        } else if (rule.select) {
          ok = v !== "";
        } else if (rule.numeric) {
          ok = /^[0-9]+$/.test(v);
        } else {
          ok = v.length >= rule.min;
        }
        valid[id] = ok;
        if (touched[id]) {
          el.classList.toggle("f-invalid", !ok);
          el.classList.toggle("f-valid", ok);
          err.textContent = ok ? "" : msg;
          err.classList.toggle("show", !ok);
        }
      }

      function updateBtn() {
        btn.disabled = !Object.keys(valid).every(function (k) {
          return valid[k];
        });
      }

      // Number of stores: strip any non-digit characters as the user types or pastes
      var n6El = document.getElementById("n6");
      if (n6El) {
        n6El.addEventListener("input", function () {
          var digitsOnly = this.value.replace(/[^0-9]/g, "");
          if (digitsOnly !== this.value) this.value = digitsOnly;
        });
      }

      Object.keys(rules).forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.addEventListener("input", function () {
          touched[id] = true;
          validate(id);
          updateBtn();
        });
        el.addEventListener("blur", function () {
          touched[id] = true;
          validate(id);
          updateBtn();
        });
      });

      function showSuccess() {
        btn.classList.add("btn-success");
        btn.textContent = "✓ Sent!";
        setTimeout(function () {
          document.getElementById("formBody").style.display = "none";
          var ok = document.getElementById("okBody");
          ok.style.display = "flex";
          ok.style.animation = "ok-fadein 0.5s ease forwards";
          setTimeout(resetForm, 7000);
        }, 1500);
      }

      function resetForm() {
        var ok = document.getElementById("okBody");
        ok.style.animation = "none";
        ok.style.transition = "opacity 0.3s ease";
        ok.style.opacity = "0";
        setTimeout(function () {
          ok.style.cssText = "";
          document.getElementById("formBody").style.display = "";
          Object.keys(rules).forEach(function (id) {
            var el = document.getElementById(id),
              err = document.getElementById(id + "Err");
            if (el) {
              el.tagName === "SELECT"
                ? (el.selectedIndex = 0)
                : (el.value = "");
              el.classList.remove("f-valid", "f-invalid");
            }
            if (err) {
              err.textContent = "";
              err.classList.remove("show");
            }
          });
          touched = {};
          Object.keys(valid).forEach(function (k) {
            valid[k] = false;
          });
          btn.classList.remove("btn-success", "btn-loading");
          btn.textContent = "Get my version set";
          btn.disabled = true;
          srvErr.textContent = "";
          srvErr.classList.remove("show");
        }, 300);
      }

      btn.addEventListener("click", function () {
        Object.keys(rules).forEach(function (id) {
          touched[id] = true;
          validate(id);
        });
        updateBtn();
        if (btn.disabled) return;

        var payload = {
          form_id: "vvp-us-retail-lead",
          page: "vvp-us-retail",
          campaign: "VVP US Retail",
          name: document.getElementById("n1").value.trim(),
          email: document.getElementById("n2").value.trim(),
          fields: [
            {
              label: "Company",
              value: document.getElementById("n3").value.trim(),
            },
            {
              label: "Role",
              value: document.getElementById("n4").value.trim(),
            },
            {
              label: "You are",
              value: document.getElementById("n5").value.trim(),
            },
            {
              label: "Number of stores",
              value: document.getElementById("n6").value.trim(),
            },
            {
              label: "Weekly ad or store list",
              value: document.getElementById("n7").value.trim(),
            },
          ],
        };

        srvErr.textContent = "";
        srvErr.classList.remove("show");
        btn.disabled = true;
        btn.textContent = "Sending…";

        fetch("/api/send-campaign-mail.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        })
          .then(function (res) {
            return res.json().then(function (d) {
              return { ok: res.ok, data: d };
            });
          })
          .then(function (res) {
            if (res.ok && res.data.success) {
              showSuccess();
            } else {
              throw new Error(
                res.data.message || "Something went wrong. Please try again.",
              );
            }
          })
          .catch(function (err) {
            updateBtn();
            btn.textContent = "Get my version set";
            srvErr.textContent = err.message;
            srvErr.classList.add("show");
          });
      });
    })();
  </script>
  <script is:inline slot="scripts">
    const _rv = document.querySelectorAll(".rv");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0, rootMargin: "0px 0px -8% 0px" },
      );
      _rv.forEach((el) => io.observe(el));
      setTimeout(() => _rv.forEach((el) => el.classList.add("in")), 3000);
    }
  </script>
</Layout>
