    <header class="top">
      <a class="logo" id="flipickLogo" href="https://flipick.com"
        ><img src="/individual/fmcg/images/Flipick.webp" alt="Flipick" /></a
      >
      <span class="badge" id="prepBadge"
        >Prepared for <b id="prepName"></b></span
      >
    </header>

    <section class="hero" id="hero">
      <div class="hero-inner">
        <h1 id="heroHeadline"></h1>
        <p class="sub" id="heroSub"></p>
        <a class="btn js-cta" href="#">Book a call</a>
      </div>
    </section>

    <div class="pipeline">
      <span><b>1 master render</b> (Google Omni)</span><span>→</span>
      <span><b>Flipick SmartCrop</b> adapts it</span><span>→</span>
      <span><b>Every size · language · market</b></span><span>·</span>
      <span>No re-rendering. No re-generation.</span>
    </div>

    <main class="wrap">
      <!-- Each section below is built entirely from C.sections.<key> by the bootstrap script.
       A section whose config key is null/absent is removed outright, never left empty. -->

      <section class="feature" id="section-size">
        <p class="eyebrow" id="size-eyebrow"></p>
        <h2 id="size-heading"></h2>
        <p class="lede" id="size-lede"></p>
        <ul class="points" id="size-points"></ul>
        <div class="row size" data-group="size" id="size-row"></div>
        <div class="controls">
          <button class="btn ghost js-sync" data-group="size"
            >▶ Play all in sync</button>
        </div>
      </section>

      <section class="feature" id="section-language">
        <p class="eyebrow" id="language-eyebrow"></p>
        <h2 id="language-heading"></h2>
        <p class="lede" id="language-lede"></p>
        <ul class="points" id="language-points"></ul>
        <div class="row pair" data-group="language" id="language-row"></div>
        <div class="controls">
          <button class="btn ghost js-sync" data-group="language"
            >▶ Compare in sync</button>
        </div>
      </section>

      <section class="feature" id="section-dataVariant">
        <p class="eyebrow" id="dataVariant-eyebrow"></p>
        <h2 id="dataVariant-heading"></h2>
        <p class="lede" id="dataVariant-lede"></p>
        <ul class="points" id="dataVariant-points"></ul>
        <div class="row pair" data-group="dataVariant" id="dataVariant-row">
        </div>
        <div class="controls">
          <button class="btn ghost js-sync" data-group="dataVariant"
            >▶ Compare in sync</button>
        </div>
      </section>
    </main>

    <section class="closing">
      <h2>Your next campaign, in every format, language and market.</h2>
      <p>
        One master render, then unlimited accurate adaptations with Flipick
        SmartCrop.
      </p>
      <a class="btn js-cta" href="#">Book a call</a>
    </section>

    <footer>
      <div id="disclaimer"></div>
      <div style="margin-top:6px">
        © Flipick · <a href="https://flipick.com">flipick.com</a>
      </div>
    </footer>

    <dialog id="cmpDlg" aria-label="Compare videos">
      <div class="modal" id="cmpModal"></div>
    </dialog>

    <script is:inline src="https://player.vimeo.com/api/player.js"></script>
    <script is:inline>
      (function () {
        var C = window.LANDING_CONFIG;
        var SECTION_KEYS = ["size", "language", "dataVariant"];

        /* ---- Page title/description (optional overrides) ---- */
        if (C.pageTitle)
          document.getElementById("pageTitle").textContent = C.pageTitle;
        if (C.pageDescription)
          document
            .getElementById("pageDescription")
            .setAttribute("content", C.pageDescription);

        /* ---- Hero ---- */
        document.getElementById("heroHeadline").textContent =
          C.hero.headline || "";
        var sub = document.getElementById("heroSub");
        if (C.hero.subheadline) sub.textContent = C.hero.subheadline;
        else sub.remove();
        var hero = document.getElementById("hero");
        var isPhone = window.matchMedia("(max-width:640px)").matches;
        var heroVid = isPhone
          ? C.hero.video9x16 || C.hero.video16x9
          : C.hero.video16x9;
        if (heroVid) {
          var hv = document.createElement("video");
          hv.className = "hero-media";
          hv.src = heroVid;
          hv.muted = true;
          hv.loop = true;
          hv.autoplay = true;
          hv.playsInline = true;
          if (C.hero.image) hv.poster = C.hero.image;
          hero.prepend(hv);
          var sb = document.createElement("button");
          sb.className = "btn ghost sound";
          sb.textContent = "🔊 Sound on";
          sb.onclick = function () {
            hv.muted = !hv.muted;
            sb.textContent = hv.muted ? "🔊 Sound on" : "🔇 Sound off";
          };
          hero.appendChild(sb);
        } else if (C.hero.image) {
          var hi = document.createElement("img");
          hi.className = "hero-media";
          hi.src = C.hero.image;
          hi.alt = "";
          hero.prepend(hi);
        }

        /* ---- CTA, logo, footer ---- */
        document.querySelectorAll(".js-cta").forEach(function (a) {
          if (!C.cta || !C.cta.show) {
            a.remove();
            return;
          }
          a.textContent = C.cta.text || "Book a call";
          a.href = C.cta.url || "#";
          if (C.cta.url) {
            a.target = "_blank";
            a.rel = "noopener";
          }
        });
        if (!C.showFlipickLogo)
          document.getElementById("flipickLogo").style.visibility = "hidden";
        document.getElementById("disclaimer").textContent =
          C.footerDisclaimer || "";

        /* ---- Build one feature section's copy + video row from C.sections.<key>.
         Returns the resolved videoSlots array (used by the sync/compare button),
         or null if the section was removed. ---- */
        function buildSection(key) {
          var cfg = C.sections && C.sections[key];
          var sectionEl = document.getElementById("section-" + key);
          if (!cfg) {
            sectionEl.remove();
            return null;
          }

          document.getElementById(key + "-eyebrow").textContent =
            cfg.eyebrow || "";
          document.getElementById(key + "-heading").textContent =
            cfg.heading || "";
          var lede = document.getElementById(key + "-lede");
          if (cfg.lede) lede.textContent = cfg.lede;
          else lede.remove();
          var pointsEl = document.getElementById(key + "-points");
          if (cfg.points && cfg.points.length) {
            cfg.points.forEach(function (p) {
              var li = document.createElement("li");
              li.textContent = p;
              pointsEl.appendChild(li);
            });
          } else {
            pointsEl.remove();
          }

          var rowEl = document.getElementById(key + "-row");
          var slots = (cfg.videoSlots || []).filter(function (s) {
            return s && s.src;
          });
          if (!slots.length) {
            // No real videos to show -- drop the whole section rather than show an empty row.
            sectionEl.remove();
            return null;
          }
          slots.forEach(function (slot) {
            var tile = document.createElement("div");
            tile.className = "tile";
            if (slot.aspectRatio) tile.dataset.ar = slot.aspectRatio;
            var frame = document.createElement("div");
            frame.className = "frame";
            frame.dataset.vid = "1";
            if (slot.aspectRatio) {
              var parts = String(slot.aspectRatio).split(":").map(Number);
              if (parts.length === 2 && parts[0] && parts[1])
                frame.style.aspectRatio = parts[0] + " / " + parts[1];
              // Size tiles: give wider aspect ratios proportionally more row width.
              if (key === "size")
                tile.style.flex = parts[0] / parts[1] + " 1 0";
            }
            var iframe = document.createElement("iframe");
            var src =
              slot.src +
              (slot.src.indexOf("?") >= 0 ? "&" : "?") +
              "controls=1&dnt=1";
            iframe.src = src;
            iframe.setAttribute("frameborder", "0");
            iframe.allow = "autoplay; fullscreen; picture-in-picture";
            frame.appendChild(iframe);
            tile.appendChild(frame);
            var label = document.createElement("div");
            label.className = "label";
            label.textContent = slot.label || "";
            if (slot.sub) {
              var small = document.createElement("small");
              small.textContent = slot.sub;
              label.appendChild(small);
            }
            tile.appendChild(label);
            rowEl.appendChild(tile);
          });
          return slots;
        }

        var resolvedSlots = {};
        SECTION_KEYS.forEach(function (key) {
          resolvedSlots[key] = buildSection(key);
        });

        /* ---- "Play/compare in sync" modal: generic N-column version, used by every section ---- */
        var cmpDlg = document.getElementById("cmpDlg");
        var cmpModal = document.getElementById("cmpModal");
        var modalPlayers = [];

        function closeCompare() {
          modalPlayers.forEach(function (p) {
            p.pause().catch(function () {});
          });
          modalPlayers = [];
          cmpModal.innerHTML = "";
          cmpDlg.close();
        }
        cmpDlg.addEventListener("cancel", function (e) {
          e.preventDefault();
          closeCompare();
        });
        cmpDlg.addEventListener("click", function (e) {
          if (e.target === cmpModal) closeCompare();
        });

        function openSync(key) {
          var slots = resolvedSlots[key];
          if (!slots || !slots.length) return;
          modalPlayers.forEach(function (p) {
            p.pause().catch(function () {});
          });
          modalPlayers = [];

          var isPhoneNow = window.innerWidth < 640;
          var n = slots.length;
          var gaps = (n - 1) * 18;
          var availW = Math.min(1100, window.innerWidth - 40) - gaps;
          var sumAr = slots.reduce(function (s, sl) {
            var parts = sl.aspectRatio
              ? String(sl.aspectRatio).split(":").map(Number)
              : [16, 9];
            return s + parts[0] / parts[1];
          }, 0);
          var maxH = window.innerHeight - 260;
          var tileH = Math.floor(Math.min(availW / sumAr, maxH));

          var cols = slots
            .map(function (sl) {
              var parts = sl.aspectRatio
                ? String(sl.aspectRatio).split(":").map(Number)
                : [16, 9];
              var ar = parts[0] / parts[1];
              var w, h;
              if (isPhoneNow) {
                var availMobileW = window.innerWidth - 32;
                w = availMobileW;
                h = Math.floor(w / ar);
              } else {
                w = Math.floor(tileH * ar);
                h = tileH;
              }
              var src =
                sl.src +
                (sl.src.indexOf("?") >= 0 ? "&" : "?") +
                "background=1&muted=1&loop=1&controls=0&dnt=1";
              return (
                '<div class="cmpcol"><span class="col-label">' +
                (sl.label || "") +
                "</span>" +
                '<div class="mplayer" style="width:' +
                w +
                "px;height:" +
                h +
                'px">' +
                '<iframe src="' +
                src +
                '" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" style="pointer-events:none"></iframe>' +
                "</div></div>"
              );
            })
            .join("");

          var title =
            key === "size"
              ? "All sizes · Same master"
              : key === "language"
                ? "Same film · Every language"
                : "Same master · Every variant";

          cmpModal.innerHTML =
            '<div class="mhead"><span class="mtitle">' +
            title +
            "</span>" +
            '<button class="x" type="button" aria-label="Close">&#215;</button></div>' +
            '<div class="mbody' +
            (isPhoneNow ? " stack" : "") +
            '">' +
            cols +
            "</div>" +
            '<div class="mfoot"><button id="cmpPlayBtn">&#9654; Play all</button>' +
            '<button id="cmpRestartBtn">&#8635; Restart</button></div>';

          cmpModal.querySelector(".x").onclick = closeCompare;
          cmpModal.querySelectorAll(".mplayer iframe").forEach(function (f) {
            modalPlayers.push(new Vimeo.Player(f));
          });
          wirePosters(modalPlayers, slots);

          var playing = false;
          var playBtn = document.getElementById("cmpPlayBtn");
          playBtn.onclick = function () {
            playing = !playing;
            modalPlayers.forEach(function (p) {
              playing
                ? p.play().catch(function () {})
                : p.pause().catch(function () {});
            });
            playBtn.textContent = playing ? "⏸ Pause all" : "▶ Play all";
          };
          document.getElementById("cmpRestartBtn").onclick = function () {
            modalPlayers.forEach(function (p) {
              p.setCurrentTime(0).catch(function () {});
            });
            if (!playing) playBtn.click();
          };

          if (!cmpDlg.open) cmpDlg.showModal();
          cmpModal.querySelector(".x").focus();
        }

        document.querySelectorAll(".js-sync").forEach(function (b) {
          b.addEventListener("click", function () {
            openSync(b.dataset.group);
          });
        });

        /* ---- Vimeo thumbnail fetch + poster wiring ---- */
        var thumbCache = {};
        function vimeoThumb(src) {
          var id = (String(src).match(/video\/(\d+)/) || [])[1];
          if (!id) return Promise.resolve(null);
          return (thumbCache[id] =
            thumbCache[id] ||
            fetch(
              "https://vimeo.com/api/oembed.json?url=" +
                encodeURIComponent("https://vimeo.com/" + id) +
                "&width=640",
            )
              .then(function (r) {
                return r.ok ? r.json() : null;
              })
              .then(function (d) {
                return (d && d.thumbnail_url) || null;
              })
              .catch(function () {
                return null;
              }));
        }
        function wirePosters(players, slots) {
          players.forEach(function (vp, i) {
            var iframe = vp.element;
            if (!iframe) return;
            var mplayer = iframe.closest(".mplayer");
            if (!mplayer) return;
            var poster = document.createElement("div");
            poster.className = "ovl-poster";
            mplayer.appendChild(poster);
            vimeoThumb((slots && slots[i] && slots[i].src) || iframe.src).then(
              function (url) {
                if (url) poster.style.backgroundImage = 'url("' + url + '")';
              },
            );
            vp.on("playing", function () {
              poster.style.opacity = "0";
              poster.style.pointerEvents = "none";
            });
          });
        }

        /* ---- Fix size-tile frame heights on mobile (aspect-ratio CSS ignored by flex column) ---- */
        function fixSizeTileHeights() {
          var mobile = window.innerWidth <= 640;
          document
            .querySelectorAll(".row.size .frame[data-ar]")
            .forEach(function (f) {
              if (mobile) {
                var parts = f.dataset.ar.split(":").map(Number);
                var ar = parts[0] / parts[1];
                f.style.height = Math.round(f.offsetWidth / ar) + "px";
              } else {
                f.style.height = "";
              }
            });
        }
        fixSizeTileHeights();
        window.addEventListener("resize", fixSizeTileHeights);

        /* ---- Optional "Prepared for X" personalisation via ?for=<key> ---- */
        var p = C.personalization || {};
        var names = p.names || {};
        var tag = (
          new URLSearchParams(location.search).get(p.param || "for") || ""
        )
          .toLowerCase()
          .trim();
        if (names[tag]) {
          document.getElementById("prepName").textContent = names[tag];
          document.getElementById("prepBadge").classList.add("show");
        }

        /* ---- GA4 ---- */
        if (C.ga4Id) {
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + C.ga4Id;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            dataLayer.push(arguments);
          };
          gtag("js", new Date());
          gtag("config", C.ga4Id);
        }
      })();
    </script>
  </body>
</html>
