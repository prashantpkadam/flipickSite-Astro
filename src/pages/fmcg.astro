<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/assets/images/favicon_io/favicon.ico"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/images/favicon_io/apple-touch-icon.png"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title id="pageTitle">Flipick — One master. Every adaptation.</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta
      id="pageDescription"
      name="description"
      content="One master film, adapted by Flipick SmartCrop into every size, language and market — without re-rendering."
    />
    <style is:inline>
      /* ===== Brand tokens ===== */
      :root {
        --bg: #0b0d12;
        --surface: #141821;
        --ink: #f4f1ea;
        --muted: #a9adb8;
        --accent: #c9a45c;
        --accent-2: #5b8cff;
        --radius: 14px;
        --gap: 20px;
        --font-display: "Playfair Display", Georgia, "Times New Roman", serif;
        --font-body:
          "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
      }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
      }
      .wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Header + personalisation badge */
      header.top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
        max-width: 1280px;
        margin: 0 auto;
      }
      .logo {
        text-decoration: none;
        display: flex;
        align-items: center;
      }
      .logo img {
        height: clamp(26px, 4vw, 34px);
        width: auto;
        display: block;
      }
      .badge {
        display: none;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        border: 1px solid var(--accent);
        color: var(--accent);
        padding: 6px 12px;
        border-radius: 999px;
      }
      .badge.show {
        display: inline-block;
      }
      .badge b {
        color: var(--ink);
        letter-spacing: 0.04em;
        text-transform: none;
        font-size: 13px;
      }

      /* Hero */
      .hero {
        position: relative;
        min-height: 72vh;
        display: grid;
        place-items: center;
        text-align: center;
        overflow: hidden;
      }
      .hero-media {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.55;
      }
      .hero-inner {
        position: relative;
        padding: 96px 24px;
        max-width: 900px;
      }
      .hero h1 {
        font-family: var(--font-display);
        font-size: clamp(34px, 6vw, 68px);
        line-height: 1.08;
        margin: 0 0 16px;
      }
      .hero p.sub {
        font-size: clamp(16px, 2vw, 20px);
        color: var(--muted);
        margin: 0 auto 28px;
        max-width: 680px;
      }
      .btn {
        display: inline-block;
        background: var(--accent);
        color: #111;
        font-weight: 600;
        padding: 14px 26px;
        border-radius: 999px;
        text-decoration: none;
        border: 0;
        cursor: pointer;
        font-size: 15px;
      }
      .btn.ghost {
        background: transparent;
        color: var(--ink);
        border: 1px solid #ffffff33;
      }
      .sound {
        position: absolute;
        right: 20px;
        bottom: 20px;
      }

      /* Pipeline strip */
      .pipeline {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
        padding: 28px 24px;
        border-top: 1px solid #ffffff14;
        border-bottom: 1px solid #ffffff14;
        color: var(--muted);
        font-size: 14px;
      }
      .pipeline span b {
        color: var(--ink);
      }

      /* Feature sections */
      section.feature {
        padding: 88px 0 40px;
      }
      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 10px;
      }
      .feature h2 {
        font-family: var(--font-display);
        font-size: clamp(28px, 4vw, 44px);
        margin: 0 0 14px;
        line-height: 1.15;
      }
      .lede {
        color: var(--muted);
        max-width: 760px;
        margin: 0 0 18px;
        font-size: 17px;
      }
      ul.points {
        list-style: none;
        padding: 0;
        margin: 0 0 36px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        font-size: 14px;
      }
      ul.points li::before {
        content: "◆";
        color: var(--accent);
        margin-right: 8px;
        font-size: 10px;
        vertical-align: 2px;
      }

      /* Comparison rows */
      .row {
        display: flex;
        gap: var(--gap);
        align-items: flex-end;
        flex-wrap: wrap;
      }
      .tile {
        min-width: 0;
        display: flex;
        flex-direction: column;
        flex: 1 1 0;
      }
      .frame {
        position: relative;
        width: 100%;
        background: var(--surface);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 10px 40px #0007;
      }
      .frame iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
      .missing {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        text-align: center;
        padding: 12px;
        font-size: 13px;
        color: #ffb4a8;
        background: repeating-linear-gradient(
          45deg,
          #1b1f29 0 12px,
          #171a22 12px 24px
        );
      }
      .label {
        margin-top: 12px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.03em;
      }
      .label small {
        display: block;
        font-weight: 400;
        color: var(--muted);
        font-size: 12px;
        margin-top: 2px;
      }

      .controls {
        display: flex;
        gap: 12px;
        margin-top: 22px;
        flex-wrap: wrap;
      }
      .note {
        font-size: 12px;
        color: var(--muted);
        margin-top: 10px;
      }

      /* Closing CTA + footer */
      .closing {
        text-align: center;
        padding: 96px 24px;
      }
      .closing h2 {
        font-family: var(--font-display);
        font-size: clamp(28px, 4vw, 42px);
        margin: 0 0 12px;
      }
      .closing p {
        color: var(--muted);
        max-width: 640px;
        margin: 0 auto 28px;
      }
      footer {
        border-top: 1px solid #ffffff14;
        padding: 28px 24px;
        text-align: center;
        color: var(--muted);
        font-size: 13px;
      }

      /* Responsive */
      @media (max-width: 1024px) {
        .row.size {
          align-items: flex-start;
        }
        .row.size .tile {
          flex: 1 1 calc(50% - var(--gap)) !important;
        }
      }
      @media (max-width: 640px) {
        .row {
          flex-direction: column;
          align-items: stretch;
        }
        .row.size .tile {
          flex: none !important;
          width: 100%;
        }
        .row.pair .tile {
          flex: none !important;
          width: 100%;
        }
        .row .tile .label {
          text-align: center;
        }
        section.feature {
          padding: 64px 0 24px;
        }
        .controls .btn {
          display: block;
          width: 100%;
          text-align: center;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        iframe {
          animation: none;
        }
      }

      /* ---- Compare overlay modal ---- */
      dialog {
        border: 0;
        padding: 0;
        background: transparent;
        max-width: none;
        max-height: none;
        width: 100%;
        height: 100%;
        color: var(--ink);
      }
      dialog::backdrop {
        background: rgba(10, 12, 16, 0.88);
      }
      .modal {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: max(20px, env(safe-area-inset-top, 0px)) 20px
          max(20px, env(safe-area-inset-bottom, 0px));
        gap: 14px;
      }
      .mhead {
        width: min(1100px, 100%);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
      }
      .mhead .mtitle {
        font-family: var(--font-display);
        font-size: 18px;
        font-weight: 400;
      }
      .mhead .x {
        margin-left: auto;
        background: rgba(244, 241, 234, 0.12);
        border: 0;
        border-radius: 999px;
        width: 40px;
        height: 40px;
        cursor: pointer;
        color: var(--ink);
        font-size: 22px;
        line-height: 1;
      }
      .mbody {
        position: relative;
        display: flex;
        gap: 18px;
        justify-content: center;
        align-items: flex-start;
        width: min(1100px, 100%);
        flex-wrap: nowrap;
        overflow: hidden;
      }
      .mbody.stack {
        flex-direction: column;
        align-items: center;
      }
      .mplayer {
        position: relative;
        border-radius: var(--radius);
        overflow: hidden;
        flex-shrink: 0;
      }
      .mplayer iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
      .cmpcol {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
      }
      .cmpcol .col-label {
        font-size: 13px;
        color: var(--muted);
        letter-spacing: 0.04em;
      }
      .mfoot {
        display: flex;
        gap: 10px;
        align-items: center;
        font-size: 14px;
      }
      .mfoot button {
        background: rgba(244, 241, 234, 0.12);
        border: 0;
        color: var(--ink);
        border-radius: 999px;
        padding: 9px 18px;
        cursor: pointer;
        font-size: 14px;
      }
      .mfoot button:hover {
        background: rgba(244, 241, 234, 0.22);
      }
      .ovl-poster {
        position: absolute;
        inset: 0;
        background: var(--surface) center/cover no-repeat;
        transition: opacity 0.5s ease;
        z-index: 2;
        border-radius: var(--radius);
      }
      @media (max-width: 639px) {
        dialog {
          position: fixed;
          inset: 0;
          overflow: hidden;
        }
        .modal {
          overflow-y: auto;
          justify-content: flex-start;
          padding-left: 16px;
          padding-right: 16px;
          height: 100%;
        }
        .mhead {
          position: sticky;
          top: 0;
          background: var(--bg);
          z-index: 10;
          padding: 14px 0 10px;
          margin-bottom: 0;
        }
        .mfoot {
          position: sticky;
          bottom: 0;
          background: var(--bg);
          z-index: 10;
          padding: 10px 0 14px;
          margin-top: 0;
        }
        .mbody {
          flex-shrink: 0;
        }
        .mbody.stack .cmpcol {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <!--__CONFIG_START__-->
