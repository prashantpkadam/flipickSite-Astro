---
import Layout from "../layouts/Layout.astro";
import schema from "../data/schema/shopify-usa.json";
---

<Layout
  title="Shopify Product Video at Catalog Scale | Flipick"
  description="Connect your Shopify store and every SKU gets video. One master film, versioned from your product feed, current with your prices. For US brands and agencies."
  keywords="Shopify product video, catalog video, SKU video, ecommerce video at scale, Shopify Plus agency video"
  page="shopify-usa"
  schema={schema}
>
  <main>
    <!-- ================= HERO ================= -->
    <section class="hero camp-hero">
      <div class="wrap">
        <span class="eyebrow dk">Shopify video</span>
        <h1>You have 800 products. <em>And video for eleven.</em></h1>
        <p class="lead mt-18">
          Connect your Shopify store and every SKU gets video. One master film,
          versioned from your product feed, current with your prices.
        </p>
        <div class="btns mid mt-18">
          <a
            class="btn btn-primary"
            data-demo-link
            href="https://calendly.com/rahul-uppal-flipick/30min"
            target="_blank"
            rel="noopener noreferrer">Book a demo</a
          >
          <a href="#start" class="btn btn-ghost">Send us your store URL</a>
        </div>
        <div class="shopify-vid-wrap rv">
          <div class="vid" data-vid="shopify-hero">
            <img
              class="vid-thumb"
              src="/assets/images/thumbnail/Shopify-video.webp"
              alt="Shopify catalog video — made on Flipick"
              loading="lazy"
              width="820"
              height="461"
            />
            <span class="badge">CATALOG VIDEO &middot; MADE ON FLIPICK</span>
            <div class="ov lower3">
              <b>One master &middot; 800 SKU versions</b><span
                >SHOPIFY PRODUCT CATALOG</span>
            </div>
            <a href="#" class="play" aria-label="Play video"></a>
          </div>
        </div>
        <p class="trustline">
          Founded 2011 &middot; Fifteen years in video technology &middot;
          Trusted by <strong>Pearson</strong>, <strong>IIBF</strong>, <strong
            >Godrej</strong
          >, <strong>Jindal Steel</strong>, <strong>IFC World Bank Group</strong
          > and <strong>IICA</strong>
        </p>
      </div>
    </section>

    <!-- ================= THE PROBLEM ================= -->
    <section class="sec" id="how">
      <div class="wrap">
        <div class="prob">
          <div class="rv">
            <span class="eyebrow">The problem</span>
            <h2>
              Video converts. Per SKU quotes are why most of your catalog never
              gets any.
            </h2>
            <p class="lead mt-18">
              Every quote you have received prices video by the product. So you
              shoot the hero SKUs, leave the long tail static, and the catalog
              that carries your margin goes to market as a photograph. That is a
              cost model, not a creative decision.
            </p>
          </div>
          <div class="rv figs">
            <div>
              <strong>11 SKUs</strong><span
                >What a per product quote lets you cover.</span>
            </div>
            <div class="hot">
              <strong>800 SKUs</strong><span
                >What your store, ads and feeds are asking for.</span>
            </div>
            <div>
              <strong>Same budget</strong><span
                >The cost sits in the master, not the versions after it.</span>
            </div>
          </div>
        </div>
        <div class="three">
          <div class="card rv">
            <div class="num">1</div>
            <h3>One master film</h3>
            <p>
              Storyboard approved before a credit is spent. Presenter, product
              and brand world locked scene to scene. No crew, no shoot day.
            </p>
          </div>
          <div class="card rv">
            <div class="num">2</div>
            <h3>Your product feed</h3>
            <p>
              Title, image set, variant, price, compare at price, inventory
              status and collection become the variable fields.
            </p>
          </div>
          <div class="card rv">
            <div class="num">3</div>
            <h3>Every SKU, every format</h3>
            <p>
              Product page, Reels and Shorts, Meta and TikTok, email and
              retargeting. 9:16 and 16:9 from one run.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= WHO THIS IS FOR ================= -->
    <section class="sec mist" id="who">
      <div class="wrap">
        <div class="sh rv">
          <span class="eyebrow">Who this is for</span>
          <h2>Same pipeline. Two opposite reasons to want it.</h2>
        </div>
        <div class="aud rv">
          <div class="l">
            <span class="tag tag-a">For brands</span>
            <h3>Cover the catalog you already own</h3>
            <p>
              You are choosing which products deserve video because production
              math forces the choice. This removes the choice.
            </p>
            <ul class="dots">
              <li>
                Product page video across the full catalog, long tail included
              </li>
              <li>Creative volume for paid without a new retainer</li>
              <li>
                Change a price in the admin and the version refreshes from the
                feed
              </li>
              <li>Seasonal and promo refreshes without a reshoot</li>
            </ul>
            <p class="who">
              <strong>Who runs this:</strong> Ecommerce Director, Head of Growth,
              Performance Marketing lead, D2C founder
            </p>
          </div>
          <div class="r">
            <span class="tag tag-b">For agencies</span>
            <h3>Quote the job you keep losing</h3>
            <p>
              Your client wants video across their catalog. You price it per
              SKU, they decline, and the scope dies in the deck. This is a line
              item they will approve.
            </p>
            <ul class="dots">
              <li>
                A retainer category that does not exist in your book today
              </li>
              <li>Say yes to 400 versions and still make margin on the job</li>
              <li>Volume aggregates across your client book, not per client</li>
              <li>
                You keep the client, the strategy, the media and the
                relationship
              </li>
            </ul>
            <p class="who">
              <strong>Models:</strong> managed, white label, self serve or referral.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= COMPARE ================= -->
    <section class="sec" id="compare">
      <div class="wrap">
        <div class="sh rv">
          <span class="eyebrow">Compare</span>
          <h2>Against how catalog video gets made today.</h2>
        </div>
        <div class="tscroll rv">
          <table class="cmp">
            <thead>
              <tr>
                <th>Dimension</th>
                <th>Per SKU production</th>
                <th>Typical AI video tools</th>
                <th class="win">Flipick</th>
              </tr>
            </thead>
            <tbody>
              <tr
                ><td>Cost of SKU 500</td><td>Roughly the cost of SKU 1</td><td
                  >A new generation each time</td
                ><td class="win">A fraction of the master, and falling</td></tr
              >
              <tr
                ><td>Catalog coverage</td><td>Hero products only</td><td
                  >Whatever you prompt, one at a time</td
                ><td class="win">The full feed, long tail included</td></tr
              >
              <tr
                ><td>Price accuracy</td><td
                  >Baked in, a change means a re-edit</td
                ><td>Baked into the generation</td><td class="win"
                  >On the overlay, refreshed from the feed</td
                ></tr
              >
              <tr
                ><td>Brand consistency</td><td
                  >Depends on the shoot and the editor</td
                ><td>Drifts between generations</td><td class="win"
                  >Presenter and product locked across the catalog</td
                ></tr
              >
              <tr
                ><td>Formats per SKU</td><td>Quoted separately</td><td
                  >Re-run per aspect ratio</td
                ><td class="win">9:16 and 16:9 from one run</td></tr
              >
              <tr
                ><td>New product</td><td>Joins the next production cycle</td><td
                  >Manual, one at a time</td
                ><td class="win">Enters the queue from the feed</td></tr
              >
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT FORM ================= -->
    <section class="sec dark" id="start">
      <div class="wrap close">
        <div class="rv">
          <span class="eyebrow dk">Next step</span>
          <h2>Send us your store URL. We will send back the videos.</h2>
          <p class="lead dk mt-18">
            Pick any collection. We build the master and the version set on your
            brand, from your live product data, before you commit to anything.
          </p>
          <div class="answers">
            <div>
              <b>Does every product need its own film?</b> No. That is the whole point.
              One master carries the treatment and the catalog supplies what changes.
            </div>
            <div>
              <b>How fast is the first set?</b> 7 business days for the master, then
              batches for the catalog.
            </div>
            <div>
              <b>How is our catalog and customer data handled?</b> US Google Cloud.
            </div>
          </div>
        </div>
        <div class="rv">
          <div class="form">
            <div id="formBody">
              <h3>Get my product videos</h3>
              <div class="two">
                <div class="field">
                  <label for="n1">Name <span class="required">*</span></label
                  ><input id="n1" type="text" placeholder="Jane Doe" /><div
                    class="field-error"
                    id="n1Err"
                  >
                  </div>
                </div>
                <div class="field">
                  <label for="n2"
                    >Work email <span class="required">*</span></label
                  ><input
                    id="n2"
                    type="email"
                    placeholder="jane@company.com"
                  /><div class="field-error" id="n2Err"></div>
                </div>
              </div>
              <div class="two">
                <div class="field">
                  <label for="n3">Company <span class="required">*</span></label
                  ><input id="n3" type="text" placeholder="Company name" /><div
                    class="field-error"
                    id="n3Err"
                  >
                  </div>
                </div>
                <div class="field">
                  <label for="n4">Role <span class="required">*</span></label
                  ><input
                    id="n4"
                    type="text"
                    placeholder="Head of Growth"
                  /><div class="field-error" id="n4Err"></div>
                </div>
              </div>
              <div class="two">
                <div class="field">
                  <label for="n5">You are <span class="required">*</span></label
                  >
                  <select id="n5">
                    <option value="">— select one —</option>
                    <option>D2C brand</option>
                    <option>Shopify Plus merchant</option>
                    <option>Agency</option>
                    <option>Retailer with a Shopify store</option>
                  </select>
                  <div class="field-error" id="n5Err"></div>
                </div>
                <div class="field">
                  <label for="n6"
                    >Number of SKUs <span class="required">*</span></label
                  ><input
                    id="n6"
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    placeholder="800"
                  /><div class="field-error" id="n6Err"></div>
                </div>
              </div>
              <div class="field">
                <label for="n7">Store URL <span class="required">*</span></label
                ><input id="n7" type="text" placeholder="yourstore.com" /><div
                  class="field-error"
                  id="n7Err"
                >
                </div>
              </div>
              <button class="btn btn-primary send" id="send" disabled
                >Get my product videos</button
              >
              <div class="form-server-error" id="formServerErr"></div>
              <p class="ffoot">
                Prefer to talk first? <a
                  class="btn-link"
                  data-demo-link
                  href="https://calendly.com/rahul-uppal-flipick/30min"
                  target="_blank"
                  rel="noopener noreferrer">Book a demo</a>
              </p>
            </div>
            <div class="ok" id="okBody" style="display:none">
              <div class="tick">&#10003;</div>
              <h3>Thanks &#8212; message sent.</h3>
              <p>We&#8217;ve got your note and will be in touch shortly.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline slot="scripts" src="/assets/js/video-player.js"></script>
  <script is:inline slot="scripts">
    (function () {
      var rules = {
        n1: { min: 2, msg: "Please enter your name (min 2 characters)." },
        n2: {
          email: true,
          blockPersonal: true,
          msg: "Please enter a valid work email address.",
          msgPersonal:
            "Please enter your work email address. Personal email addresses such as Gmail or Yahoo are not accepted.",
        },
        n3: {
          min: 2,
          msg: "Please enter your company name (min 2 characters).",
        },
        n4: { min: 2, msg: "Please enter your role (min 2 characters)." },
        n5: { select: true, msg: "Please select an option." },
        n6: { numeric: true, msg: "Please enter numbers only (e.g. 800)." },
        n7: { min: 4, msg: "Please enter your store URL." },
      };

      var touched = {};
      var valid = {
        n1: false,
        n2: false,
        n3: false,
        n4: false,
        n5: false,
        n6: false,
        n7: false,
      };
      var btn = document.getElementById("send");
      var srvErr = document.getElementById("formServerErr");

      function validate(id) {
        var el = document.getElementById(id),
          err = document.getElementById(id + "Err"),
          rule = rules[id];
        if (!el || !err || !rule) return;
        var v = el.value.trim();
        var msg = rule.msg;
        var ok;
        if (rule.email) {
          ok = v.length > 0 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
          if (ok && rule.blockPersonal) {
            var domain = v.split("@").pop().toLowerCase();
            var blocked = (window.FLIPICK && FLIPICK.blockedEmailDomains) || [];
            if (blocked.indexOf(domain) !== -1) {
              ok = false;
              msg = rule.msgPersonal || msg;
            }
          }
        } else if (rule.select) {
          ok = v !== "";
        } else if (rule.numeric) {
          ok = /^[0-9]+$/.test(v);
        } else {
          ok = v.length >= rule.min;
        }
        valid[id] = ok;
        if (touched[id]) {
          el.classList.toggle("f-invalid", !ok);
          el.classList.toggle("f-valid", ok);
          err.textContent = ok ? "" : msg;
          err.classList.toggle("show", !ok);
        }
      }

      function updateBtn() {
        btn.disabled = !Object.keys(valid).every(function (k) {
          return valid[k];
        });
      }

      function showSuccess() {
        btn.classList.add("btn-success");
        btn.textContent = "✓ Sent!";
        setTimeout(function () {
          document.getElementById("formBody").style.display = "none";
          var ok = document.getElementById("okBody");
          ok.style.display = "flex";
          ok.style.animation = "ok-fadein 0.5s ease forwards";
          setTimeout(resetForm, 7000);
        }, 1500);
      }

      function resetForm() {
        var ok = document.getElementById("okBody");
        ok.style.animation = "none";
        ok.style.transition = "opacity 0.3s ease";
        ok.style.opacity = "0";
        setTimeout(function () {
          ok.style.cssText = "";
          document.getElementById("formBody").style.display = "";
          Object.keys(rules).forEach(function (id) {
            var el = document.getElementById(id),
              err = document.getElementById(id + "Err");
            if (el) {
              el.tagName === "SELECT"
                ? (el.selectedIndex = 0)
                : (el.value = "");
              el.classList.remove("f-valid", "f-invalid");
            }
            if (err) {
              err.textContent = "";
              err.classList.remove("show");
            }
          });
          touched = {};
          Object.keys(valid).forEach(function (k) {
            valid[k] = false;
          });
          btn.classList.remove("btn-success", "btn-loading");
          btn.textContent = "Get my product videos";
          btn.disabled = true;
          srvErr.textContent = "";
          srvErr.classList.remove("show");
        }, 300);
      }

      // Number of SKUs: strip any non-digit characters as the user types or pastes
      var n6El = document.getElementById("n6");
      if (n6El) {
        n6El.addEventListener("input", function () {
          var digitsOnly = this.value.replace(/[^0-9]/g, "");
          if (digitsOnly !== this.value) this.value = digitsOnly;
        });
      }

      Object.keys(rules).forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.addEventListener("input", function () {
          touched[id] = true;
          validate(id);
          updateBtn();
        });
        el.addEventListener("blur", function () {
          touched[id] = true;
          validate(id);
          updateBtn();
        });
      });

      btn.addEventListener("click", function () {
        Object.keys(rules).forEach(function (id) {
          touched[id] = true;
          validate(id);
        });
        updateBtn();
        if (btn.disabled) return;

        var payload = {
          form_id: "shopify-usa-lead",
          page: "shopify-usa",
          campaign: "Shopify USA",
          name: document.getElementById("n1").value.trim(),
          email: document.getElementById("n2").value.trim(),
          fields: [
            {
              label: "Company",
              value: document.getElementById("n3").value.trim(),
            },
            {
              label: "Role",
              value: document.getElementById("n4").value.trim(),
            },
            {
              label: "You are",
              value: document.getElementById("n5").value.trim(),
            },
            {
              label: "Number of SKUs",
              value: document.getElementById("n6").value.trim(),
            },
            {
              label: "Store URL",
              value: document.getElementById("n7").value.trim(),
            },
          ],
        };

        srvErr.textContent = "";
        srvErr.classList.remove("show");
        btn.disabled = true;
        btn.textContent = "Sending…";

        fetch("/api/send-campaign-mail", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        })
          .then(function (res) {
            return res.json().then(function (d) {
              return { ok: res.ok, data: d };
            });
          })
          .then(function (res) {
            if (res.ok && res.data.success) {
              showSuccess();
            } else {
              throw new Error(
                res.data.message || "Something went wrong. Please try again.",
              );
            }
          })
          .catch(function (err) {
            updateBtn();
            btn.textContent = "Get my product videos";
            srvErr.textContent = err.message;
            srvErr.classList.add("show");
          });
      });
    })();
  </script>
  <script is:inline slot="scripts">
    const _rv = document.querySelectorAll(".rv");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0, rootMargin: "0px 0px -8% 0px" },
      );
      _rv.forEach((el) => io.observe(el));
      setTimeout(() => _rv.forEach((el) => el.classList.add("in")), 3000);
    }
  </script>
</Layout>
