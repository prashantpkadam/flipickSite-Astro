---
import Layout from "../layouts/Layout.astro";
import schema from "../data/schema/ai-video-platform.json";
---

<Layout
  title="AI Video Platform for Every Team & Industry | Flipick"
  description="Flipick AI video for every team, content type and industry: L&D, marketing and customer education; training, ads and explainers; manufacturing, retail and BFSI."
  keywords="AI video platform, AI video use cases, L&D video platform, marketing video AI, training video maker, enterprise video personalization, customer education video, manufacturing training video, BFSI learning video"
  page="solutions"
  schema={schema}
>
  <main>
    <!-- ================= HERO ================= -->
    <section class="hero hero--even">
      <div class="wrap">
        <div class="hero-grid hero-grid--lg">
          <h1 class="hero-h1--md">
            Three ways in. <span class="serif-i text-brand-mid"
              >One platform.</span>
          </h1>
          <p class="sub">
            However you come to Flipick — by the team you lead, the kind of
            video you make, or the industry you're in — every path runs the same
            create → distribute → prove pipeline.
          </p>
          <div class="ways">
            <a href="#by-team">By team</a>
            <a href="#by-content">By content type</a>
            <a href="#by-industry">By industry</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= TRUSTED BY ================= -->
    <section class="section-pad-flush">
      <div class="wrap">
        <div class="logostrip logostrip-lg rv">
          <div class="lbl">Trusted by teams at</div>
          <div class="logorow">
            <div class="logoslot">
              <img
                src="/assets/images/customers/IIBF_logo.webp"
                alt="IIBF"
                width="1200"
                height="380"
                loading="lazy"
              />
            </div>
          </div>
          <p class="trusted-cap">
            Trusted by Pearson, IIBF, Godrej, Jindal Steel, IFC World Bank Group
            and IICA
          </p>
        </div>
      </div>
    </section>

    <!-- ================= BY TEAM ================= -->
    <section
      id="by-team"
      aria-label="Solutions by team"
      class="section-white section-pad-lg"
    >
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">By team</span>
          <h2>
            Built for the people <span class="serif-i text-brand"
              >who ship video.</span>
          </h2>
        </div>

        <div class="feat feat--pt-sm rv">
          <div class="media">
            <div class="vid small t4" data-vid="solutions-ld">
              <img
                class="vid-thumb"
                src="https://img.youtube.com/vi/wfMoSIuWX_Q/maxresdefault.jpg"
                alt="Play video"
                loading="lazy"
              />
              <span class="badge">SAMPLE · ONE LESSON, FIVE LANGUAGES</span>
              <div class="ov lower3">
                <b
                  >&#2319;&#2325; &#2361;&#2368;
                  &#2361;&#2379;&#2360;&#2381;&#2335;</b
                ><span
                  >&#2361;&#2367;&#2306;&#2342;&#2368; &middot;
                  &#2357;&#2361;&#2368; &#2310;&#2357;&#2366;&#2360;&#2364;</span>
              </div>
              <a
                href="#"
                class="play"
                aria-label="Play video"
                target="_blank"
                rel="noopener noreferrer"></a>
            </div>
          </div>
          <div>
            <span class="flagtag">L&amp;D, MARKETING &amp; CUSTOMER TEAMS</span>
            <h3>The same studio, tuned to your team's job.</h3>
            <p class="leadp">
              L&amp;D ships multilingual training people actually finish;
              marketing makes on-brand promos at calendar speed; customer teams
              send personalized walkthroughs — all from one pipeline.
            </p>
            <ul class="bul">
              <li>
                L&amp;D &amp; training — finished, multilingual, assessable
              </li>
              <li>Marketing — ads, promos and launch films, on brand</li>
              <li>Customer education — onboarding, how-tos, walkthroughs</li>
            </ul>
          </div>
        </div>

        <div class="team-grid feat--pt-lg rv">
          <div class="team">
            <div class="role">L&amp;D / Training</div>
            <h4>Training people actually finish</h4>
            <p>
              Turn policies and SOPs into hosted, multilingual video, and prove
              completion. Customers cut training video production from 8 weeks
              to 5 days.
            </p>
            <div class="makes">
              Onboarding &middot; Compliance &middot; Skills &middot; SOPs
            </div>
          </div>
          <div class="team">
            <div class="role">Marketing</div>
            <h4>On-brand video at calendar speed</h4>
            <p>
              Ads, promos and launch films in-house, with accurate products and
              tracked CTAs. In-house video at around 1/3 the cost of traditional
              production.
            </p>
            <div class="makes">
              Ads &middot; Promos &middot; Launch &middot; Social
            </div>
          </div>
          <div class="team">
            <div class="role">Customer Education &amp; Success</div>
            <h4>Help customers help themselves</h4>
            <p>
              Personalized walkthroughs and how-tos, delivered per account and
              measured. One master film, a unique version for every customer.
            </p>
            <div class="makes">
              Walkthroughs &middot; How-tos &middot; Onboarding
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= BY CONTENT TYPE ================= -->
    <section
      id="by-content"
      aria-label="Solutions by content type"
      class="section-pad-lg"
    >
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">By content type</span>
          <h2>
            Every kind of video <span class="serif-i text-brand"
              >your team ships.</span>
          </h2>
        </div>

        <div class="feat feat--pt-sm rev rv">
          <div class="media">
            <div class="vid small t3" data-vid="solutions-promo">
              <img
                class="vid-thumb"
                src="https://img.youtube.com/vi/wfMoSIuWX_Q/maxresdefault.jpg"
                alt="Play video"
                loading="lazy"
              />
              <span class="badge">SAMPLE · FESTIVE PRODUCT PROMO</span>
              <div class="ov price">&#8377;4,999 <small>FESTIVE</small></div>
              <div class="ov cta">Shop now &rarr;</div>
              <a
                href="#"
                class="play"
                aria-label="Play video"
                target="_blank"
                rel="noopener noreferrer"></a>
            </div>
          </div>
          <div>
            <span class="flagtag"
              >TRAINING &middot; ADS &middot; FILM &middot; EXPLAINERS</span
            >
            <h3>One platform, from the lesson to the launch film.</h3>
            <p class="leadp">
              Structured training, campaign-ready promos, narrative films with a
              consistent cast, and clear product explainers — produced the same
              way, on brand, at speed.
            </p>
            <ul class="bul">
              <li>Re-skin a promo's price and offer without re-rendering</li>
              <li>Consistent characters across a narrative film</li>
              <li>Explainers that end on a tracked next step</li>
            </ul>
          </div>
        </div>

        <div class="ct-grid feat--pt-lg rv">
          <div class="ct">
            <div class="ic">&#9636;</div><b>Training</b><span
              >Structured, multilingual, assessable lessons.</span>
          </div>
          <div class="ct">
            <div class="ic">&#9889;</div><b>Ads &amp; promos</b><span
              >Campaign-ready, re-skinnable, on brand.</span>
          </div>
          <div class="ct">
            <div class="ic">&#9673;</div><b>Film &amp; story</b><span
              >Narrative pieces with a consistent cast.</span>
          </div>
          <div class="ct">
            <div class="ic">&#9656;</div><b>Explainers</b><span
              >Clear how-tos that drive a next step.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= BY INDUSTRY ================= -->
    <section
      id="by-industry"
      aria-label="Solutions by industry"
      class="section-white section-pad-lg"
    >
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">By industry</span>
          <h2>
            Tuned to how <span class="serif-i text-brand"
              >your sector works.</span>
          </h2>
        </div>

        <div class="feat feat--pt-sm rv">
          <div class="media">
            <div class="vid small t2" data-vid="solutions-personal">
              <img
                class="vid-thumb"
                src="https://img.youtube.com/vi/wfMoSIuWX_Q/maxresdefault.jpg"
                alt="Play video"
                loading="lazy"
              />
              <span class="badge">SAMPLE · ONE FILM, PERSONAL VERSIONS</span>
              <div class="ov lower3">
                <b>Verified viewer &middot; R. Sharma</b><span
                  >AUTHENTICATED &middot; PER RECIPIENT</span>
              </div>
              <div class="ov cta">Acknowledge &rarr;</div>
              <a
                href="#"
                class="play"
                aria-label="Play video"
                target="_blank"
                rel="noopener noreferrer"></a>
            </div>
          </div>
          <div>
            <span class="flagtag"
              >MULTILINGUAL &middot; ACCURATE &middot; AUDIT-READY</span
            >
            <h3>The same wins, sector by sector.</h3>
            <p class="leadp">
              Safety and SOPs on the plant floor, re-skinnable promos in retail,
              authenticated compliance in BFSI — personalized, in the right
              language, with proof of who watched.
            </p>
            <ul class="bul">
              <li>Accurate equipment and products where it counts</li>
              <li>Vernacular versions for a distributed workforce</li>
              <li>Authenticated, audit-ready completion records</li>
            </ul>
          </div>
        </div>

        <div
          class="fcard rv"
          style="border-left:4px solid var(--brand);padding:1.25rem 1.5rem;margin-bottom:1.5rem;max-width:760px"
        >
          <strong>Variable Video Production (VVP) for retail &amp; BFSI</strong>
          <p style="margin-top:.5rem">
            For retail and financial services, Flipick uses Variable Video
            Production — each recipient gets a version with their name, account
            balance, renewal date, local offer or dealer address inserted from
            your CRM. One master film, rendered into thousands of personalized
            versions, each delivered via a unique authenticated link.
          </p>
        </div>
        <div class="ind-list rv">
          <div class="ind">
            <div class="nm">
              <span class="dot">MFG</span><b>Manufacturing</b>
            </div><p>
              Safety, SOP and line-training video — multilingual for a
              distributed frontline.
            </p>
          </div>
          <div class="ind">
            <div class="nm"><span class="dot">RTL</span><b>Retail</b></div><p>
              Frontline &amp; seasonal onboarding, plus promos with
              price/offer/QR overlays that update without re-rendering. VVP
              delivers a unique version per store or customer.
            </p>
          </div>
          <div class="ind">
            <div class="nm">
              <span class="dot">BFSI</span><b>Financial services</b>
            </div><p>
              Compliance &amp; product training with viewer authentication and
              audit-ready tracking. VVP personalises renewal and policy videos
              at scale.
            </p>
          </div>
          <div class="ind">
            <div class="nm">
              <span class="dot">F&amp;B</span><b>Food &amp; beverage</b>
            </div><p>
              Standards, hygiene and franchise training — consistent across
              every location.
            </p>
          </div>
          <div class="ind">
            <div class="nm"><span class="dot">SW</span><b>Software</b></div><p>
              Product launches, feature explainers and customer onboarding
              video.
            </p>
          </div>
          <div class="ind">
            <div class="nm"><span class="dot">HC</span><b>Healthcare</b></div><p
            >
              Compliance training, patient education and staff onboarding —
              authenticated and audit-ready.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section id="faq" aria-label="Frequently asked questions">
      <div class="wrap">
        <div class="sec-head rv sec-head--center sec-head--mb-md">
          <span class="eyebrow">FAQ</span>
          <h2>
            Common questions about <span class="serif-i text-brand"
              >Flipick's AI Video Platform.</span>
          </h2>
        </div>
        <div class="faq rv">
          <details open>
            <summary>What is the Flipick AI Video Platform?</summary>
            <p>
              Flipick is a studio-grade AI video creation platform that lets
              L&amp;D, marketing and customer teams create, personalise and
              prove video end to end &mdash; from a single pipeline that covers
              every content type and industry.
            </p>
          </details>
          <details>
            <summary>Which teams use Flipick?</summary>
            <p>
              L&amp;D and training teams ship multilingual, assessable courses;
              marketing teams produce on-brand ads and promos at calendar speed;
              and customer education teams send personalised walkthroughs and
              onboarding videos &mdash; all from the same platform.
            </p>
          </details>
          <details>
            <summary>What types of video can I create?</summary>
            <p>
              Training videos (structured, multilingual, assessable), ads and
              promos (campaign-ready, re-skinnable), narrative films (consistent
              cast across scenes), and explainer videos (clear how-tos with
              tracked next steps).
            </p>
          </details>
          <details>
            <summary>Which industries does Flipick serve?</summary>
            <p>
              Manufacturing (safety and SOP training), retail (frontline
              onboarding and promos), BFSI (compliance with audit-ready
              tracking), food and beverage (franchise training), software
              (product launches and explainers), and healthcare (compliance and
              patient education).
            </p>
          </details>
          <details>
            <summary>How does Flipick personalise videos at scale?</summary>
            <p>
              Flipick delivers a unique version of each video per recipient
              using variable data fields &mdash; names, products, prices and
              offers swap automatically without re-rendering. Every view is
              authenticated, so you get verified completion data, not just view
              counts.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- ================= CLOSING CTA ================= -->
    <section class="closing" aria-label="Call to action">
      <div class="wrap">
        <h2>
          Whichever way you start, <span class="serif-i"
            >you finish with proof.</span>
        </h2>
        <p>
          Tell us your team, your content or your industry — we'll show you the
          fastest path to your first video.
        </p>
        <div class="ctas-center">
          <a
            class="btn btn-ghost"
            data-demo-link
            href="https://calendly.com/amol-chandsarkar/"
            target="_blank"
            rel="noopener noreferrer">Book a demo</a
          >
        </div>
        <p class="also-explore">
          Also explore: <a href="/lms">Flipick LMS</a> &middot; <a
            href="/ppt-to-scorm">PowerPoint &rarr; SCORM</a
          > &middot; <a href="/pricing">Pricing</a>
        </p>
      </div>
    </section>
  </main>

  <script is:inline slot="scripts" src="/assets/js/video-player.js"></script>
</Layout>
