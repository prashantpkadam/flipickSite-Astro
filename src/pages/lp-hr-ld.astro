---
import Layout from "../layouts/Layout.astro";
import schema from "../data/schema/lp-hr-ld.json";
---

<Layout
  title="Enterprise Video Platform for HR & L&D | Flipick"
  description="Transform your L&D content into engaging AI-powered videos. Training manuals, SOPs, and presentations now effortlessly converted into interactive videos."
  keywords="enterprise video platform HR L&D, AI video training, L&D content AI video, HR training video platform, employee training video"
  page="lp-hr-ld"
  schema={schema}
>
  <main>
    <!-- ================= HERO ================= -->
    <section class="hero lp-hero">
      <div class="wrap">
        <div class="hero-grid-2col lp-hero-grid">
          <div class="rv">
            <span class="eyebrow">AI-Powered Enterprise Video Platform</span>
            <h1 class="hero-h1-fluid">
              Transform Your L&amp;D Content into <span
                class="serif-i text-brand-mid">Engaging AI-Powered Videos</span>
            </h1>
            <p class="sub hero-sub-sm">
              <strong
                >Training manuals, SOPs, and presentations &mdash; now
                effortlessly converted into interactive videos.</strong>
            </p>
            <div class="lp-check-list">
              <span class="lp-check">AI Powered</span>
              <span class="lp-check">Simple Steps</span>
              <span class="lp-check">Multilingual Support</span>
            </div>
            <div class="ctas">
              <a
                class="btn btn-primary"
                data-demo-link
                href="https://calendly.com/amol-chandsarkar/"
                target="_blank"
                rel="noopener noreferrer"
                ><span class="tri"></span>Schedule Your Video Creation</a
              >
            </div>
          </div>
          <div class="rv rv-delayed">
            <img
              src="/assets/images/lp-hr-ld/lp-hero.webp"
              alt="Flipick Platform Overview"
              class="lp-hero-img"
              width="1600"
              height="1200"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ================= SAMPLE VIDEOS ================= -->
    <section class="lp-videos-section">
      <div class="wrap">
        <div class="sec-head rv sec-head--center sec-head--sm">
          <span class="eyebrow">See It In Action</span>
          <h2>
            Sample videos made on <span class="serif-i text-brand"
              >Flipick Platform</span>
          </h2>
        </div>

        <div class="lp-videos-grid rv">
          <div>
            <div class="lp-video-label">Introduction to Flipick</div>
            <div class="lp-video-wrap">
              <div class="vid t2" data-vid="lp-intro">
                <img
                  class="vid-thumb"
                  src=""
                  alt="Introduction to Flipick"
                  loading="lazy"
                />
                <span class="badge"
                  >SAMPLE &middot; INTRODUCTION TO FLIPICK</span
                >
                <div class="ov lower3">
                  <b>AI-Powered Learning Platform</b><span
                    >FLIPICK OVERVIEW</span>
                </div>
                <a href="#" class="play" aria-label="Play introduction video"
                ></a>
              </div>
            </div>
          </div>
          <div>
            <div class="lp-video-label">
              Preventing Harassment &mdash; POSH Training
            </div>
            <div class="lp-video-wrap">
              <div class="vid t3" data-vid="lp-posh">
                <img
                  class="vid-thumb"
                  src=""
                  alt="Preventing Harassment — POSH Training"
                  loading="lazy"
                />
                <span class="badge">SAMPLE &middot; POSH TRAINING</span>
                <div class="ov lower3">
                  <b>Preventing Harassment in the Workplace</b><span
                    >COMPLIANCE TRAINING</span>
                </div>
                <a href="#" class="play" aria-label="Play POSH training video"
                ></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= FREE OFFER ================= -->
    <section class="lp-offer-section">
      <div class="wrap">
        <div class="sec-head rv sec-head--center sec-head--md">
          <span class="eyebrow">Try It Free</span>
          <h2>
            Experience Flipick&rsquo;s AI-Powered Enterprise Video Platform <span
              class="serif-i text-brand">for Free!</span>
          </h2>
          <p>
            Let us turn one of your existing training materials into a
            high-quality, AI-generated video of under 10 minutes &mdash; at no
            cost, no commitment.
          </p>
        </div>

        <div class="lp-offer rv">
          <div>
            <h3>Why Try Flipick?</h3>
            <p>
              See what&rsquo;s possible before you commit a single rupee or
              dollar.
            </p>
            <div class="lp-why-list">
              <div class="lp-why">
                <div class="lp-why-icon">⚡</div>
                <div class="lp-why-text">
                  <b>Instant Transformation</b>
                  <span
                    >Convert static documents into dynamic learning videos in
                    days, not weeks.</span
                  >
                </div>
              </div>
              <div class="lp-why">
                <div class="lp-why-icon">🎙️</div>
                <div class="lp-why-text">
                  <b>AI-Powered Narration</b>
                  <span
                    >Professional voiceovers and avatars in minutes. No voice
                    talent needed.</span
                  >
                </div>
              </div>
              <div class="lp-why">
                <div class="lp-why-icon">🎯</div>
                <div class="lp-why-text">
                  <b>Scalable &amp; Customizable</b>
                  <span
                    >Tailor videos for different roles and teams. One upload,
                    many versions.</span
                  >
                </div>
              </div>
            </div>
            <div class="lp-offer-cta">
              <a
                class="btn btn-primary"
                data-demo-link
                href="https://calendly.com/amol-chandsarkar/"
                target="_blank"
                rel="noopener noreferrer"
                ><span class="tri"></span>Schedule Your Video Creation</a
              >
            </div>
          </div>
          <div class="lp-offer-img">
            <img
              src="/assets/images/lp-hr-ld/why-try-flipick.webp"
              alt="Corporate Training Solutions"
              class="lp-offer-img-real"
              width="747"
              height="661"
            />
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ================= PLATFORM FEATURES ================= -->
    <section class="lp-features-section">
      <div class="wrap">
        <div class="sec-head rv sec-head--center sec-head--sm sec-head--mb-sm">
          <span class="eyebrow">Platform Features</span>
          <h2>
            Everything your L&amp;D team <span class="serif-i text-brand"
              >needs.</span>
          </h2>
        </div>

        <!-- Feature 1: AI Personalization -->
        <div class="lp-feat rv">
          <div class="lp-feat-img">
            <img
              src="/assets/images/lp-hr-ld/AI-Powered-Personalization.webp"
              alt="AI-Powered Personalization"
              width="539"
              height="359"
              loading="lazy"
            />
          </div>
          <div>
            <span class="flagtag">AI Personalization</span>
            <h3 class="lp-feature-h3">Content that adapts to every viewer.</h3>
            <p class="leadp">
              Deliver videos that feel unique to each user by integrating
              AI-powered customization tools. With Flipick, your videos can
              dynamically update based on CRM data or user inputs, ensuring
              every viewer has a relevant, tailored experience.
            </p>
            <ul class="bul">
              <li>
                Dynamic variable substitution &mdash; name, role, location
              </li>
              <li>Department-specific content tracks</li>
              <li>Adapts to learner&rsquo;s language and region</li>
              <li>One master video, hundreds of personalized cuts</li>
            </ul>
          </div>
        </div>

        <!-- Feature 2: Voice Cloning & Multilingual -->
        <div class="lp-feat rev rv">
          <div class="lp-feat-img">
            <img
              src="/assets/images/lp-hr-ld/3_Platform_Voice-Cloning-and-Multilingual-Support.webp"
              alt="Voice Cloning and Multilingual Support"
              width="511"
              height="405"
              loading="lazy"
            />
          </div>
          <div>
            <span class="flagtag">Voice Cloning &amp; Multilingual</span>
            <h3 class="lp-feature-h3">
              Reach global audiences in their language.
            </h3>
            <p class="leadp">
              Expand your reach with voice cloning and multilingual
              capabilities. Flipick&rsquo;s voice technology enables you to
              localize content for global audiences while maintaining
              consistency in messaging and tone.
            </p>
            <ul class="bul">
              <li>
                Clone your narrator&rsquo;s voice &mdash; no re-recording needed
              </li>
              <li>Support for 30+ languages</li>
              <li>Culturally adapted scripts and visuals</li>
              <li>Consistent brand voice across all languages</li>
            </ul>
          </div>
        </div>

        <!-- Feature 3: Rich Analytics -->
        <div class="lp-feat rv">
          <div class="lp-feat-img">
            <img
              src="/assets/images/lp-hr-ld/Rich-Analytics.webp"
              alt="Rich Analytics Dashboard"
              width="539"
              height="359"
              loading="lazy"
            />
          </div>
          <div>
            <span class="flagtag">Rich Analytics</span>
            <h3 class="lp-feature-h3">See exactly what&rsquo;s working.</h3>
            <p class="leadp">
              Flipick&rsquo;s analytics tools let you see who&rsquo;s watching,
              how long they&rsquo;re watching, and where they&rsquo;re
              interacting most. Leverage these insights to optimize content and
              drive engagement, ensuring your videos deliver value at every
              stage.
            </p>
            <ul class="bul">
              <li>Real-time viewer tracking and completion rates</li>
              <li>Drop-off points and heatmaps</li>
              <li>Team and department-level reporting</li>
              <li>Export data to your LMS or BI tools</li>
            </ul>
          </div>
        </div>

        <!-- Feature 4: Assessments & Certifications -->
        <div class="lp-feat rev rv">
          <div class="lp-feat-img">
            <img
              src="/assets/images/lp-hr-ld/Built-In-Assessments-and-Certifications.webp"
              alt="Built-In Assessments and Certifications"
              width="539"
              height="359"
              loading="lazy"
            />
          </div>
          <div>
            <span class="flagtag">Assessments &amp; Certifications</span>
            <h3 class="lp-feature-h3">Validate learning. Issue proof.</h3>
            <p class="leadp">
              Add assessments directly within videos to validate knowledge and
              comprehension. Create interactive quizzes, issue completion
              certificates, and monitor progress, making Flipick ideal for
              compliance training, employee onboarding, and professional
              certifications.
            </p>
            <ul class="bul">
              <li>In-video quizzes and knowledge checks</li>
              <li>Automatically issued completion certificates</li>
              <li>Pass/fail thresholds and retry logic</li>
              <li>SCORM and xAPI compliant reporting</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CUSTOMERS ================= -->
    <div class="lp-customers">
      <div class="wrap">
        <div class="sec-head rv sec-head--center sec-head--xs">
          <span class="eyebrow">Our Customers</span>
          <h2>
            Trusted by <span class="serif-i text-brand"
              >leading organisations</span>
          </h2>
        </div>
        <div class="lp-logo-marquee rv">
          <div class="lp-lm-track">
            <div class="lp-lm-card">
              <img
                src="/assets/images/customers/IIBF_logo.webp"
                alt="IIBF"
                width="1200"
                height="380"
              />
            </div>
            <div class="lp-lm-card">
              <img
                src="/assets/images/customers/Pearson_logo.webp"
                alt="Pearson"
                width="1200"
                height="380"
              />
            </div>
            <div class="lp-lm-card">
              <img
                src="/assets/images/customers/logo_iica.webp"
                alt="IICA"
                width="1200"
                height="380"
              />
            </div>
            <div class="lp-lm-card">
              <img
                src="/assets/images/customers/PI-horizontal-logo.webp"
                alt="PI"
                width="1200"
                height="380"
              />
            </div>
            <div class="lp-lm-card">
              <img
                src="/assets/images/customers/IIBF_logo.webp"
                alt="IIBF"
                width="1200"
                height="380"
              />
            </div>
            <div class="lp-lm-card">
              <img
                src="/assets/images/customers/Pearson_logo.webp"
                alt="Pearson"
                width="1200"
                height="380"
              />
            </div>
            <div class="lp-lm-card">
              <img
                src="/assets/images/customers/logo_iica.webp"
                alt="IICA"
                width="1200"
                height="380"
              />
            </div>
            <div class="lp-lm-card">
              <img
                src="/assets/images/customers/PI-horizontal-logo.webp"
                alt="PI"
                width="1200"
                height="380"
              />
            </div>
          </div>
        </div>
        <p class="lp-customers-note">
          Joining 150,000+ active learners already on the Flipick platform
        </p>
      </div>
    </div>

    <!-- ================= FAQ ================= -->
    <section id="faq" aria-label="Frequently asked questions">
      <div class="wrap">
        <div class="sec-head rv sec-head--center sec-head--mb-md">
          <span class="eyebrow">FAQ</span>
          <h2>
            Common questions about <span class="serif-i text-brand"
              >AI video for HR &amp; L&amp;D.</span>
          </h2>
        </div>
        <div class="faq rv">
          <details open>
            <summary
              >How does Flipick convert existing training materials into
              AI-powered videos?</summary
            >
            <p>
              Flipick analyzes your documents, SOPs, and presentations and
              transforms them into cinematic, host-led training videos using AI
              narration and dynamic visuals. The process typically takes days,
              not weeks, and you can update a single line of content without
              reshooting the entire module.
            </p>
          </details>
          <details>
            <summary
              >Can Flipick videos be used for compliance and certification
              training?</summary
            >
            <p>
              Yes. Flipick supports in-video quizzes, pass/fail thresholds, and
              automatically issued completion certificates. The platform is
              SCORM and xAPI compliant, making it suitable for compliance,
              onboarding, and professional certification programs.
            </p>
          </details>
          <details>
            <summary
              >Does Flipick support multilingual training for global teams?</summary
            >
            <p>
              Flipick supports voice cloning and localization into 30+
              languages. You can clone a narrator&#8217;s voice so no
              re-recording is needed, and visuals and scripts can be culturally
              adapted to maintain consistent brand voice across all languages.
            </p>
          </details>
          <details>
            <summary
              >How does Flipick personalize training videos for different roles
              and departments?</summary
            >
            <p>
              Flipick uses AI-powered personalization to dynamically update
              videos based on CRM data or user inputs. Variables such as name,
              role, location, and department can be substituted automatically,
              so one master video can produce hundreds of personalized training
              versions.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- ================= CLOSING CTA ================= -->
    <section class="closing" aria-label="Call to action">
      <div class="wrap">
        <h2>
          See your L&amp;D content <span class="serif-i">in action.</span>
        </h2>
        <p>
          Let us talk about how Flipick can help you deliver impactful,
          personalized videos for your audience. Get your free AI-powered
          training video today.
        </p>
        <div class="ctas-center">
          <a
            class="btn btn-primary"
            data-demo-link
            href="https://calendly.com/amol-chandsarkar/"
            target="_blank"
            rel="noopener noreferrer"
            ><span class="tri"></span>Schedule Your Video Creation</a
          >
        </div>
      </div>
    </section>
  </main>

  <script is:inline slot="scripts" src="/assets/js/video-player.js"></script>
</Layout>
