<script is:inline>
  document.querySelectorAll('.video-wrap').forEach(wrap => {
    const vid = wrap.querySelector('video');
    wrap.addEventListener('mouseenter', () => { if (!vid.hasAttribute('muted')) vid.muted = false; vid.play().catch(()=>{}); wrap.classList.add('playing'); });
    wrap.addEventListener('mouseleave', () => { vid.pause(); vid.currentTime = 0; wrap.classList.remove('playing'); });
    wrap.addEventListener('click', () => {
      if (vid.paused) { vid.play().catch(()=>{}); wrap.classList.add('playing'); }
      else { vid.pause(); wrap.classList.remove('playing'); }
    });
  });
</script>
