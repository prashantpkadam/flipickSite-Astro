---
import Layout from "../layouts/Layout.astro";
import schema from "../data/schema/forAgencies.json";
---

<Layout
  title="Flipick for Agencies: White-Label AI Video Platform"
  description="Flipick for Agencies: a white-label AI video studio. Produce cinematic AI video, then turn one master into thousands of personalized variants under your brand."
  keywords="AI video for agencies, white label video platform, agency video production, variable video production, video engine for agencies, agency partner program"
  page="forAgencies"
  schema={schema}
>
  <main>
    <!-- ================= HERO ================= -->
    <section class="hero camp-hero">
      <div class="wrap">
        <span class="eyebrow dk">For agencies</span>
        <h1>
          The AI video engine <span class="serif-i"
            >for agencies at scale.</span>
        </h1>
        <p class="lead mt-18">
          Make cinematic AI video, then turn one master into thousands of
          variants, across sizes, languages and data, at a fraction of the cost.
          White-labeled on your own tenant.
        </p>
        <div class="btns mid mt-18">
          <a class="btn btn-primary" href="/company#contact">Become a partner</a
          >
          <a class="btn btn-ghost" href="#how">See how it works</a>
        </div>
      </div>
    </section>

    <!-- ================= VIDEO SHOWREEL ================= -->
    <section class="camp-flush">
      <div class="lwrap">
        <div class="vid rv" data-vid="agencies-hero">
          <img
            class="vid-thumb"
            src="/assets/images/thumbnail/For_agencies.webp"
            alt="Play Flipick for agencies explainer"
            width="1920"
            height="1080"
            loading="lazy"
          />
          <span class="badge">PLATFORM &middot; ONE ENGINE, EVERY CLIENT</span>
          <div class="ov lower3">
            <b>One platform, every client account</b><span
              >BUILT FOR AGENCIES</span>
          </div>
          <a
            href="#"
            class="play"
            aria-label="Play video"
            target="_blank"
            rel="noopener noreferrer"></a>
        </div>
        <div class="engrow rv">
          <div class="engbox">Veo</div>
          <div class="engbox">Kling</div>
          <div class="engbox">Omni</div>
          <div class="engbox">ElevenLabs</div>
        </div>
        <p class="leadp engine-lead rv">
          A studio and a variable-video engine in one platform. Every major
          engine, one workflow, under your creative and your client
          relationship.
        </p>
      </div>
    </section>

    <!-- ================= THE ECONOMICS ================= -->
    <section class="camp-section">
      <div class="lwrap">
        <div class="sec-head rv camp-sh">
          <span class="eyebrow">The economics</span>
          <h2>
            Render the master once. <span class="serif-i"
              >Everything after costs a fraction.</span>
          </h2>
        </div>
        <div class="split rv">
          <div class="splitcard master">
            <span class="eyebrow">Master film</span>
            <div class="bigp">AI render</div>
            <div class="sublabel">Paid once, on AI</div>
          </div>
          <div class="splitarrow">&rarr;</div>
          <div class="splitcard variants">
            <span class="eyebrow">Every variant</span>
            <div class="bigp">A fraction</div>
            <div class="sublabel">
              Rendered on our servers, not re-rendered on AI
            </div>
            <div class="vchips">
              <span>16:9</span><span>9:16</span><span>1:1</span><span>5:4</span
              ><span>+ languages</span><span>+ names</span><span
                >+ overlays</span>
            </div>
          </div>
        </div>
        <p class="leadp engine-lead rv">
          One master becomes 30 or 40 finished videos, and your cost per video
          keeps falling as you scale.
        </p>
      </div>
    </section>

    <!-- ================= WHAT YOU GET ================= -->
    <section class="camp-section">
      <div class="lwrap">
        <div class="sec-head rv camp-sh">
          <span class="eyebrow">What you get</span>
          <h2>
            A production studio, plus the variable layer no generator has.
          </h2>
        </div>
        <div class="grid2">
          <div class="fcard camp-fcard border-brand rv">
            <h3>Cinematic AI studio</h3><p>
              Brief in a chat interface, then lock characters, locations, props
              and elements into shots &mdash; from brief to storyboard to
              finished film.
            </p>
          </div><div class="fcard camp-fcard border-teal rv">
            <h3>Variable Video Production</h3><p>
              One master, unlimited variants: sizes, languages, overlays and
              data. Upload a spreadsheet and put a name in the overlay and the
              voiceover.
            </p>
          </div><div class="fcard camp-fcard border-amber rv">
            <h3>Your tenant, brands &amp; API</h3><p>
              White-labeled on your own tenant, with per-client brand kits,
              shared character and location libraries, batches, review and
              publish, and a Video Engine API.
            </p>
          </div><div class="fcard camp-fcard border-brand rv">
            <h3>Built-in distribution</h3><p>
              Push finished variants straight to channels like WhatsApp and
              Instagram, so client video reaches the consumer journey, not just
              the asset folder.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= HOW AGENCIES USE IT ================= -->
    <section class="camp-section">
      <div class="lwrap">
        <div class="sec-head rv camp-sh">
          <span class="eyebrow">How agencies use it</span>
          <h2>Where it earns its place.</h2>
        </div>
        <div class="grid2">
          <div class="fcard camp-fcard rv">
            <h3>Performance &amp; A/B testing</h3><p>
              Build one hero master, then A/B test messaging by swapping
              overlays &mdash; with no AI re-render per variant.
            </p>
          </div><div class="fcard camp-fcard rv">
            <h3>E-commerce at scale</h3><p>
              Product-description videos across a client&rsquo;s catalog, and
              last season&rsquo;s assets refreshed by changing the overlay,
              price or language.
            </p>
          </div><div class="fcard camp-fcard rv">
            <h3>Localization</h3><p>
              One production into every language you sell in, voiceover
              included, without re-recording.
            </p>
          </div><div class="fcard camp-fcard rv">
            <h3>Personalized &amp; data-driven</h3><p>
              Names, offers and details from a spreadsheet, rendered into the
              overlay and the voiceover.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PARTNERSHIP MODEL ================= -->
    <section class="camp-section-sm">
      <div class="lwrap">
        <div class="fcard rv camp-callout camp-callout-brand">
          <span class="eyebrow">Partnership &amp; commercials</span>
          <h3>Your creative, powered by our platform.</h3>
          <p>
            You bring the client, the strategy and the creative; Flipick
            provides the white-labeled platform and variable-video engine. The
            platform runs on credits: briefing, storyboarding and asset
            management are free, and you&rsquo;re charged only when you render a
            master on AI. Variants cost a fraction of that and scale down
            further with volume.
          </p>
          <p class="note">
            Indicative rates on request and negotiable by scale &mdash; Confirm
            the current rate card before quoting.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= CLOSING CTA ================= -->
    <section class="closing" aria-label="Call to action">
      <div class="wrap">
        <h2>
          Add a video engine <span class="serif-i"
            >to what you already offer.</span>
        </h2>
        <p>
          Bring us one brief from a live account, and we&rsquo;ll produce the
          master and a full set of variants on your brand.
        </p>
        <div class="ctas-center">
          <a class="btn btn-ghost" href="/company#contact"
            >Become a Flipick agency partner</a
          >
        </div>
      </div>
    </section>
  </main>

  <script is:inline slot="scripts" src="/assets/js/video-player.js"></script>
  <script is:inline slot="scripts">
    const _rv = document.querySelectorAll(".rv");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0, rootMargin: "0px 0px -8% 0px" },
      );
      _rv.forEach((el) => io.observe(el));
      setTimeout(() => _rv.forEach((el) => el.classList.add("in")), 3000);
    }
  </script>
</Layout>
